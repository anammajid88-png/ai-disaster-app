{
  "name": "ai-disaster-app",
  "version": "1.0.0",
  "private": true,
  "description": "Multilingual, Pakistan-focused AI disaster and emergency assistance web application.",
  "type": "commonjs",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "setup": "npm install && npm install --prefix client",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/server.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/server.js",
    "preview": "npm run preview --prefix client",
    "assets": "node scripts/generate-assets.mjs",
    "validate": "node scripts/validate-content.mjs",
    "test": "node scripts/validate-content.mjs && node scripts/test-detection.mjs",
    "test:detection": "node scripts/test-detection.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "vercel-build": "npm install --prefix client && npm run build --prefix client"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
